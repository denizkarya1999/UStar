<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00274C">

    <LinearLayout
        android:id="@+id/local_inference_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#00274C">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local Picture Inference"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:paddingBottom="12dp"
            android:textColor="#FFCB05" />

        <!-- Original vs Denoised -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Original (preview)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingBottom="4dp"
                    android:gravity="center_horizontal"
                    android:textColor="#FFCB05" />

                <ImageView
                    android:id="@+id/imageOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:background="#222222"
                    android:contentDescription="Original image preview" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Denoised (CycleGAN, random sample)"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingBottom="4dp"
                    android:gravity="center_horizontal"
                    android:textColor="#FFCB05" />

                <ImageView
                    android:id="@+id/imageDenoised"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:background="#222222"
                    android:contentDescription="CycleGAN denoised image" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/inferenceProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- MODEL SELECTION -->
        <TextView
            android:id="@+id/textModelSelectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select models to run on all selected images:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textColor="#FFCB05" />

        <LinearLayout
            android:id="@+id/modelSelectionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/checkCycleGAN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="CycleGAN-based Denoising (one random image)"
                android:textColor="#FFCB05" />

            <CheckBox
                android:id="@+id/checkOpticalRanging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="ResNet-18-based Optical Ranging Model"
                android:textColor="#FFCB05" />

            <CheckBox
                android:id="@+id/checkOrientation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="ResNet-18-based Orientation Guidance Model"
                android:textColor="#FFCB05" />
        </LinearLayout>

        <!-- Ground truth inputs -->
        <TextView
            android:id="@+id/textGroundTruthLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optional: enter ground-truth labels for accuracy:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textColor="#FFCB05" />

        <EditText
            android:id="@+id/editOpticalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Distance GT label (e.g., 1M, 2M, 3M)"
            android:singleLine="true"
            android:padding="8dp"
            android:textColor="#FFCB05"
            android:textColorHint="#80FFCB05"
            android:background="#19324F" />

        <EditText
            android:id="@+id/editOrientationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Orientation GT label (e.g., North, West, South, East)"
            android:singleLine="true"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:textColor="#FFCB05"
            android:textColorHint="#80FFCB05"
            android:background="#19324F" />

        <TextView
            android:id="@+id/textOpticalResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Optical Ranging Model: —"
            android:textSize="16sp"
            android:paddingTop="12dp"
            android:textColor="#FFCB05" />

        <TextView
            android:id="@+id/textOrientationResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orientation Guidance Model: —"
            android:textSize="16sp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:textColor="#FFCB05" />

        <!-- Row: Choose Images / Run Selected Models -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelectImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Choose Images"
                android:textColor="#00274C"
                android:background="#FFCB05" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRunInference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Run Selected Models"
                android:enabled="false"
                android:textColor="#00274C"
                android:background="#FFCB05" />
        </LinearLayout>

        <!-- NEW: Launch AR Activity button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLaunchAr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Launch AR Activity"
            android:textColor="#00274C"
            android:background="#FFCB05" />

    </LinearLayout>
</ScrollView>